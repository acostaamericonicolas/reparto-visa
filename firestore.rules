rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas de Google pueden leer y escribir. Para sumar a alguien, agregá su mail y desplegá las reglas.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'acosta.nicolas96@gmail.com',
          'nadia.m.moran@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
